{
  "name": "@istarry/spoon-companion",
  "version": "0.9.16",
  "description": "让对话角色有自己的内心和声音：心情情绪随时间和对话自己演，回复一条一条发出来，能念出声（DeepSeek / 小米 MiMo），也能听得见——点麦克风说话，本地识别后直接发送。四块都能单独关。",
  "type": "module",
  "main": "plugin.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./plugin.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "build.mjs",
    "lib/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "emotion",
    "mood",
    "persona",
    "companion",
    "chat",
    "multi-turn",
    "tts",
    "asr",
    "voice",
    "speech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iStarryDust/spoon-mood.git"
  },
  "homepage": "https://github.com/iStarryDust/spoon-mood#readme",
  "bugs": {
    "url": "https://github.com/iStarryDust/spoon-mood/issues"
  },
  "author": "ChencLi819 (upstream) / istarry (fork)",
  "license": "MIT",
  "upstream": {
    "name": "dsh-fish-mood",
    "repository": "https://github.com/ChencLi819/dsh-fish-mood",
    "license": "MIT"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.6"
  }
}
